{
  "version": 1,
  "name": "Victus Graphite",
  "appearance": "dark",
  "canvas": "@canvas@",
  "accent": "@foreground@",
  "colors": {
    "canvas": "@canvas@",
    "chrome": "@chrome@",
    "toolbar": "@background@",
    "toolbarForeground": "@foreground@",
    "toolbarBorder": "@border@",
    "toolbarControl": "@surfaceRaised@",
    "toolbarControlForeground": "@foreground@",
    "toolbarControlHover": "@color_333333@",
    "surface": "@background@",
    "surfaceRaised": "@surfaceRaised@",
    "surfaceOverlay": "@surfaceRaised@",
    "text": "@text@",
    "textMuted": "@color_8c929d@",
    "border": "@border@",
    "input": "@surfaceRaised@",
    "focus": "@blue@",
    "accent": "@foreground@",
    "accentForeground": "@chrome@",
    "secondary": "@surfaceRaised@",
    "secondaryForeground": "@foreground@",
    "muted": "@surfaceRaised@",
    "mutedForeground": "@color_8c929d@",
    "placeholder": "@color_6b6b6b@",
    "secondaryLabel": "@color_8c929d@",
    "iconMuted": "@color_8c929d@",
    "error": "@color_e05561@",
    "errorForeground": "@color_ff616e@",
    "errorSurface": "@color_2b1b1e@",
    "warning": "@orange@",
    "warningForeground": "@color_f0a45d@",
    "warningSurface": "@color_2b241c@",
    "update": "@blue@",
    "updateForeground": "@color_4dc4ff@",
    "updateSurface": "@color_16202e@",
    "accentSurface": "@surfaceHover@",
    "accentSurfaceForeground": "@foreground@",
    "messageSurface": "@surfaceRaised@",
    "messageForeground": "@text@",
    "messageAction": "@foreground@",
    "messageActionForeground": "@chrome@",
    "messageActionHover": "@color_c8cdd5@",
    "codeBackground": "@background@",
    "codeForeground": "@foreground@",
    "searchMatchBackground": "@color_7a5c22@",
    "searchMatchForeground": "@text@",
    "searchMatchActiveBackground": "@orange@",
    "searchMatchActiveForeground": "@chrome@",
    "sidebar": "@chrome@",
    "sidebarForeground": "@text@",
    "sidebarMutedForeground": "@color_8c929d@",
    "sidebarControlSurface": "@background@",
    "sidebarRowHover": "@surfaceHover@",
    "sidebarRowActive": "@color_343434@",
    "sidebarRowSelected": "@color_303030@",
    "sidebarBorder": "@surfaceHover@",
    "terminalBackground": "@background@",
    "terminalForeground": "@foreground@",
    "terminalCursor": "@foreground@",
    "terminalSelection": "@color_404040@",
    "terminalScrollbar": "@border@",
    "terminalScrollbarHover": "@color_626262@"
  }
}
