{
  "id": "victus-graphite",
  "name": "Victus Graphite",
  "version": "1.0.0",
  "author": "Local adaptation",
  "description": "One Dark Pro syntax with neutral charcoal surfaces",
  "dark": {
    "primary": "@foreground@",
    "primaryText": "@chrome@",
    "primaryContainer": "@border@",
    "secondary": "@green@",
    "surface": "@chrome@",
    "surfaceText": "@text@",
    "surfaceVariant": "@surfaceHover@",
    "surfaceVariantText": "@foreground@",
    "surfaceTint": "@foreground@",
    "background": "@background@",
    "backgroundText": "@text@",
    "outline": "@color_858585@",
    "surfaceContainerLowest": "@color_101010@",
    "surfaceContainerLow": "@chrome@",
    "surfaceContainer": "@background@",
    "surfaceContainerHigh": "@surfaceHover@",
    "surfaceContainerHighest": "@border@",
    "error": "@color_ff616e@",
    "warning": "@yellow@",
    "info": "@blue@",
    "matugen_type": "scheme-neutral"
  },
  "light": {
    "primary": "@foreground@",
    "primaryText": "@chrome@",
    "primaryContainer": "@border@",
    "secondary": "@green@",
    "surface": "@chrome@",
    "surfaceText": "@text@",
    "surfaceVariant": "@surfaceHover@",
    "surfaceVariantText": "@foreground@",
    "surfaceTint": "@foreground@",
    "background": "@background@",
    "backgroundText": "@text@",
    "outline": "@color_858585@",
    "surfaceContainerLowest": "@color_101010@",
    "surfaceContainerLow": "@chrome@",
    "surfaceContainer": "@background@",
    "surfaceContainerHigh": "@surfaceHover@",
    "surfaceContainerHighest": "@border@",
    "error": "@color_ff616e@",
    "warning": "@yellow@",
    "info": "@blue@",
    "matugen_type": "scheme-neutral"
  },
  "sourceDir": "victus-graphite"
}
