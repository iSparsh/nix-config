          },
          {
            "cursor": "@color_a1c181ff@",
            "background": "@color_a1c181ff@",
            "selection": "@color_a1c18140@"
          }
        ],
        "syntax": {
          "comment": {
            "color": "@color_7f838c@",
            "font_style": null,
            "font_weight": null
          },
          "comment.doc": {
            "color": "@color_7f848e@",
            "font_style": null,
            "font_weight": null
          },
          "attribute": {
            "color": "@orange@",
            "font_style": null,
            "font_weight": null
          },
          "boolean": {
            "color": "@orange@",
            "font_style": null,
            "font_weight": null
          },
          "constant": {
            "color": "@orange@",
            "font_style": null,
            "font_weight": null
          },
          "constructor": {
            "color": "@red@",
            "font_style": null,
            "font_weight": null
          },
          "embedded": {
            "color": "@foreground@",
            "font_style": null,
            "font_weight": null
          },
          "emphasis": {
            "color": "@purple@",
            "font_style": null,
            "font_weight": null
          },
          "enum": {
            "color": "@cyan@",
            "font_style": null,
            "font_weight": null
          },
          "function": {
            "color": "@blue@",
            "font_style": null,
            "font_weight": null
          },
          "keyword": {
            "color": "@purple@",
            "font_style": null,
            "font_weight": null
          },
          "keyword.operator": {
            "color": "@purple@",
            "font_style": null,
            "font_weight": null
          },
          "link_text": {
            "color": "@blue@",
            "font_style": null,
            "font_weight": null
          },
          "link_uri": {
            "color": "@blue@",
            "font_style": null,
            "font_weight": null
          },
          "number": {
            "color": "@orange@",
            "font_style": null,
            "font_weight": null
          },
          "operator": {
            "color": "@foreground@",
            "font_style": null,
            "font_weight": null
          },
          "predictive": {
            "color": "@color_4d5970@",
            "font_style": "italic",
            "font_weight": null
          },
          "property": {
            "color": "@red@",
            "font_style": null,
            "font_weight": null
