[main]
font=IoskeleyMonoTerm Nerd Font Mono:size=12
pad=12x12

[cursor]
style=block
blink=yes

[mouse]
hide-when-typing=yes

# Scroll speed for touchpad and mouse wheel (default: 3.0).
[scrollback]
multiplier=12.0

[colors-dark]
alpha=0.85
blur=yes
foreground=@foreground@
background=@background@
selection-foreground=@text@
selection-background=@color_404040@
cursor=@background@ @foreground@

regular0=@color_3f4451@
regular1=@color_e05561@
regular2=@color_8cc265@
regular3=@color_d18f52@
regular4=@color_4aa5f0@
regular5=@color_c162de@
regular6=@color_42b3c2@
regular7=@color_d7dae0@
bright0=@color_4f5666@
bright1=@color_ff616e@
bright2=@color_a5e075@
bright3=@color_f0a45d@
bright4=@color_4dc4ff@
bright5=@color_de73ff@
bright6=@color_4cd1e0@
bright7=@text@
